<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd job for the intraday-bias report.

  Install:
    cp scripts/com.nourbeleih.intraday-bias.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.nourbeleih.intraday-bias.plist

  It fires at 10:00 ET and retries at 10:15/10:30/10:45; scripts/bias-guard.sh
  enforces the single 10:00-10:50 window, weekdays only, and once-per-day. launchd
  runs a missed calendar time once on wake, giving the retry-if-asleep behavior.

  NOTE: StartCalendarInterval uses the Mac's LOCAL clock, while the guard window is ET
  (America/New_York). This assumes the Mac stays on ET. If its timezone ever changes
  (e.g. travel) the fires land outside the ET guard window and the day SKIPs silently
  (the dashboard shows "No run recorded"); switch to a StartInterval poll for TZ-independence.

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.nourbeleih.intraday-bias.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nourbeleih.intraday-bias</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/nourmendoza/Repos/DT/tradingview-mcp-jackson/scripts/run-intraday-bias.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>45</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/nourmendoza/.claude/local:/Users/nourmendoza/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/nourmendoza/Repos/DT/tradingview-mcp-jackson/bias-reports/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nourmendoza/Repos/DT/tradingview-mcp-jackson/bias-reports/launchd.err.log</string>
</dict>
</plist>
